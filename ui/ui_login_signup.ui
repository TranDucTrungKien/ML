          </property>
         </widget>
        </item>
        <item row="0" column="1">
         <widget class="QLineEdit" name="txtUsernameSignup"/>
        </item>
        <item row="1" column="0">
         <widget class="QLabel" name="lblEmailSignup">
          <property name="text">
