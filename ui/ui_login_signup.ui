          </property>
         </widget>
        </item>
        <item row="1" column="1">
         <widget class="QLineEdit" name="txtEmailSignup"/>
        </item>
        <item row="2" column="0">
         <widget class="QLabel" name="lblPasswordSignup">
          <property name="text">
           <string>Mật khẩu</string>
          </property>
