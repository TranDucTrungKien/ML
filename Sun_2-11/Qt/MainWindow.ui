  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #e8eaf6, stop:1 #c5cae9);
}
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3498db, stop:1 #2980b9);
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px;
    font-size: 11pt;
    font-weight: bold;
}
QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2980b9, stop:1 #1f6ba8);
}
QPushButton:pressed {
    background: #1a5490;
}
QLineEdit {
    background-color: white;
    border: 2px solid #3498db;
    border-radius: 6px;
    padding: 8px;
    font-size: 10pt;
}
QLineEdit:focus {
    border: 2px solid #2980b9;
    background-color: #f0f8ff;
}
QTableWidget {
    background-color: white;
    border: 2px solid #3498db;
    border-radius: 8px;
    gridline-color: #bdc3c7;
}
QTableWidget::item:selected {
    background-color: #3498db;
    color: white;
}
QHeaderView::section {
    background-color: #2c3e50;
    color: white;
    padding: 8px;
    border: 1px solid #34495e;
    font-weight: bold;
}
QLabel {
    color: #2c3e50;
}</string>
